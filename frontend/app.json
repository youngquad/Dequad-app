{
  "expo": {
    "name": "DEQUAD",
    "slug": "dequad",
    "version": "1.2.1",
    "icon": "./assets/images/icon.png",
    "scheme": "dequad",
    "userInterfaceStyle": "light",
    "runtimeVersion": "1.2.0",
    "updates": {
      "url": "https://u.expo.dev/0ad6a13c-845f-4ab4-9177-ba5031d2462d",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "image": "./assets/images/splash-image.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dequad.wellbeing",
      "buildNumber": "4"
    },
    "android": {
      "package": "com.dequad.wellbeing",
      "versionCode": 15,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-updates",
      [
        "expo-notifications",
        {
          "color": "#5B9BD5"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6f957baf-c80f-4809-b784-8306c547529b"
      }
    },
    "owner": "youngquad"
  }
}